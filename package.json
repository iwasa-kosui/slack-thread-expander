{
  "name": "slack-thread-expander",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "tsc": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:ci": "vitest run",
    "clasp:push": "clasp push -f",
    "deploy": "pnpm build && pnpm clasp:push"
  },
  "dependencies": {
    "@praha/byethrow": "0.11.2",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@google/clasp": "2.5.0",
    "@types/google-apps-script": "1.0.99",
    "@types/node": "24.10.4",
    "esbuild": "0.27.2",
    "oxfmt": "0.49.0",
    "oxlint": "1.67.0",
    "typescript": "5.9.3",
    "vitest": "3.1.2"
  },
  "engines": {
    "node": "24.12.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
